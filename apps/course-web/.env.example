MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/
MONGODB_DIRECT_URI=mongodb://<username>:<password>@<host-1>:27017,<host-2>:27017,<host-3>:27017/?ssl=true&authSource=admin&replicaSet=<replica-set>&retryWrites=true&w=majority
MONGODB_DB=ai_engineer_guide
COURSE_SEED_SECRET=change-this-local-seed-secret
AUTH_GOOGLE_ID=<google-oauth-client-id>
AUTH_GOOGLE_SECRET=<google-oauth-client-secret>
AUTH_SECRET=<32-plus-character-auth-secret>
GEMINI_API_KEY=<gemini-api-key>
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
